name: Incremental SEC refresh

on:
  schedule:
    - cron: "17 11 * * 1-5"
  workflow_dispatch:
    inputs:
      company_limit:
        description: "Number of configured companies to refresh"
        required: false
        default: "100"

concurrency:
  group: sec-edgar-refresh
  cancel-in-progress: false

jobs:
  refresh:
    runs-on: ubuntu-latest
    env:
      DATABASE_URL: ${{ secrets.DATABASE_URL }}
      SEC_USER_AGENT: ${{ secrets.SEC_USER_AGENT }}
      SEC_COMPANY_LIMIT: ${{ inputs.company_limit || '100' }}
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: "3.12"
          cache: pip
      - run: python -m pip install .
      - name: Validate required secrets
        shell: bash
        run: |
          test -n "$DATABASE_URL" || (echo "Missing DATABASE_URL secret" && exit 1)
          test -n "$SEC_USER_AGENT" || (echo "Missing SEC_USER_AGENT secret" && exit 1)
      - name: Migrate, ingest, and validate
        run: sec-risk run-all

